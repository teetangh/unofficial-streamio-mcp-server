{
  "name": "unofficial-streamio-mcp-server",
  "version": "0.2.0",
  "description": "Unofficial MCP server for Stream.io Chat, Video, Users, Moderation and App APIs",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "unofficial-streamio-mcp-server": "build/index.js"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "tsc --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:tools": "node scripts/generate-tool-docs.mjs",
    "docs:check": "node scripts/generate-tool-docs.mjs --check",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "npm run build",
    "test": "vitest run --exclude 'src/__tests__/integration/**'",
    "test:watch": "vitest --exclude 'src/__tests__/integration/**'",
    "test:live": "STREAM_MCP_LIVE=1 vitest run --dir src/__tests__/integration",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "probe": "node scripts/probe.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "stream",
    "stream-io",
    "getstream",
    "chat",
    "video",
    "moderation",
    "claude",
    "ai",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teetangh/unofficial-streamio-mcp-server.git"
  },
  "homepage": "https://github.com/teetangh/unofficial-streamio-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/teetangh/unofficial-streamio-mcp-server/issues"
  },
  "author": "teetangh",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@stream-io/node-sdk": "^0.8.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.68.0",
    "vitest": "^3.0.0"
  }
}
