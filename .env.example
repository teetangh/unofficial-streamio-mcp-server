# Stream app credentials — https://dashboard.getstream.io
# Required. Without these the server still starts and lists its tools, but
# every tool call fails with a clear error.
STREAM_API_KEY=your-api-key
STREAM_API_SECRET=your-api-secret

# Optional: request timeout in milliseconds. Default 15000.
# The Stream SDK's own default is 3000, which is too tight for query and
# export endpoints.
# STREAM_TIMEOUT_MS=15000

# Optional: restrict which tool groups are registered, to keep the tool
# surface (and its context cost) small. Comma-separated, or "all".
# Valid values: chat, chat-admin, video, video-admin, moderation, users, app
# STREAM_MCP_TOOLSETS=all

# Optional: register only tools annotated read-only. Strongly recommended
# when pointing the server at a production Stream app.
# STREAM_MCP_READ_ONLY=false

# Optional: cap the bytes of JSON a single tool result may return. Default 30000.
# STREAM_MCP_MAX_RESPONSE_BYTES=30000

# Optional: override the Stream API base URL (self-hosted / testing only).
# STREAM_BASE_URL=
